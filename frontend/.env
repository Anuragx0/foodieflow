# ==============================================================================
# FoodieFlow Frontend Environment Configuration
# ==============================================================================
# In Vite, client-side environment variables must be prefixed with VITE_.
# NOTE: These variables are embedded into the client bundle at BUILD TIME
# (when running `npm run build`). Whenever you change this file, you must
# rebuild the frontend and re-upload the `dist/` folder to Amazon S3.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Base URL
# ------------------------------------------------------------------------------
# - Scenario A (Direct EC2 Public IP / Domain):
#   Set VITE_API_URL to your EC2 instance (e.g. http://3.106.6.89).
#   Note: If your frontend is loaded over HTTPS on CloudFront, see Step 3 in the guide
#   for configuring CloudFront /api routing to avoid browser "Mixed Content" blocks.
#
# - Scenario B (CloudFront Unified Domain / Same-Origin - Recommended):
#   If your CloudFront distribution is configured with an additional Origin for EC2 (3.106.6.89)
#   and a Behavior forwarding /api/* to EC2, leave VITE_API_URL empty ("") so all
#   calls use clean relative paths (/api/v1/...) with zero CORS complexity.
#
# - Scenario C (Local Development):
#   Leave empty ("") to let Vite proxy /api requests to http://127.0.0.1:8000.
# ------------------------------------------------------------------------------
VITE_API_URL=http://3.106.6.89

# ------------------------------------------------------------------------------
# 2. Razorpay Public Key ID
# ------------------------------------------------------------------------------
# Your public Razorpay Key ID (rzp_test_... for Sandbox or rzp_live_... for Production).
# DO NOT place your RAZORPAY_KEY_SECRET here! Secrets belong only in backend/.env.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

