# FoodieFlow Frontend Environment Variables Example
# Duplicate this file as .env and adjust values for your environment.

# Production EC2 backend domain or leave empty if using local proxy / CloudFront /api routing
VITE_API_URL=https://api.foodieflow.campus.edu

# Public Razorpay Key ID (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_FoodieFlowDemo

